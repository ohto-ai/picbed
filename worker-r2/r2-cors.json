{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://picbed.ohtoai.top",
          "https://ohto-ai.github.io"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
